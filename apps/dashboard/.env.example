# Valores reales: en el gestor de contraseñas compartido y en Vercel. JAMÁS en git.
# La clave anon es la pública (RLS manda).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-CLAVE-ANON

# D1 — solo server-side (sin NEXT_PUBLIC_): el browser jamás los ve.
# service_role: lee runs (RLS sin policies). Solo se usa en el BFF.
SUPABASE_SERVICE_ROLE=TU-SERVICE-ROLE
# Lectura read-only de Voces/Proyectos/Ajustes mientras la config viva en Airtable (muere en D5).
# ▶ Correr ahora: URL de Producción del webhook del motor + el header de la
# credencial `Webhook Motor Header` de n8n. Deben coincidir EXACTO (si no: 403).
MOTOR_WEBHOOK_URL=https://TU-N8N/webhook/TU-PATH
MOTOR_WEBHOOK_HEADER_NOMBRE=TU-NOMBRE-DE-HEADER
MOTOR_WEBHOOK_HEADER_VALOR=TU-VALOR-DE-HEADER

# «Buscar cuentas nuevas» (Curar → Sugeridos). El buscador ya NO tiene cron: corre
# solo cuando alguien aprieta el botón (enmienda de ADR-020). Tercer par de header,
# de la credencial `Webhook Descubrimiento Header` de n8n — no reusar los otros dos.
DESCUBRIMIENTO_WEBHOOK_URL=https://TU-N8N/webhook/TU-PATH-DESCUBRIMIENTO
DESCUBRIMIENTO_WEBHOOK_HEADER_NOMBRE=TU-NOMBRE-DE-HEADER-DESC
DESCUBRIMIENTO_WEBHOOK_HEADER_VALOR=TU-VALOR-DE-HEADER-DESC

# «Archivar ahora» (Operar y el Feed, ADR-062). El archivado también corre solo los domingos 18:00
# por el dispatcher; este es el mismo webhook, disparado a mano.
# 🔑 REUSA el header del MOTOR y no es un descuido: los dos webhooks llevan la credencial
# `Webhook Motor Header` de n8n, así que lo único propio es la URL. Un par propio serían dos valores
# que TIENEN que ser idénticos, y el día que difieran el fallo es un 403 silencioso.
# 🩸 Faltó en este archivo desde que el botón se construyó, y por eso nunca se cargó en Vercel: el
# botón devolvía «Falta configurar el webhook del archivado» en producción. Se descubrió el
# 2026-08-24, pedido de Mani. Una var que no está acá no llega al deploy.
ARCHIVADO_WEBHOOK_URL=https://TU-N8N/webhook/TU-PATH-ARCHIVADO

# El enriquecimiento de metadata de las colecciones (ADR-072). Mismo token que usa n8n en el motor.
APIFY_TOKEN=TU-TOKEN-DE-APIFY

# D4 — la fachada GET /api/engine/run-plan (ADR-028, contrato core/contracts/run-plan.md).
# El header que n8n manda al preguntar qué correr. Otro par, NO reusar el del webhook.
RUN_PLAN_HEADER_NOMBRE=TU-NOMBRE-DE-HEADER-RUN-PLAN
RUN_PLAN_HEADER_VALOR=TU-VALOR-DE-HEADER-RUN-PLAN

# El transcriptor (ADR-031, zona Transcribir). Son LAS MISMAS keys que usa n8n en el motor:
# copialas del .env de la raíz, no saques unas nuevas. Sin estas, pegar links falla.
# ⚠️ `ANTHROPIC_API_KEY` la usan TRES cosas, no una: el transcriptor, la limpieza de guiones
# (ADR-074) y el botón "Explicar con IA" de la pantalla Corridas (ADR-083). Sin ella el botón avisa
# que no está configurada y la pantalla se dibuja igual.
SUPADATA_API_KEY=TU-API-KEY-DE-SUPADATA
ANTHROPIC_API_KEY=TU-API-KEY-DE-ANTHROPIC

# ── El link a la ejecución de n8n en la pantalla Corridas (ADR-083) — OPCIONAL ──
#
# Solo lo ve el rol `dev`, y solo hace falta para las corridas que salieron BIEN: el link de una
# corrida fallida viene pegado al mensaje que escribe el error handler (ADR-054), así que ese
# funciona sin configurar nada.
#
# Son las MISMAS del .env de la raíz (las usan los scripts de core/): copialas, no saques otras.
# Si faltan, no hay link y no hay error — la pantalla se dibuja igual.
N8N_BASE_URL=https://TU-INSTANCIA-DE-N8N
N8N_WF_MOTOR=ID-DEL-WORKFLOW-DEL-MOTOR
N8N_WF_ARCHIVADO=ID-DEL-WORKFLOW-DE-ARCHIVADO
N8N_WF_DESCUBRIMIENTO=ID-DEL-WORKFLOW-DE-DESCUBRIMIENTO
