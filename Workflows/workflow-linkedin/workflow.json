        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"instance_id\": \"{{ $('Config').first().json.instance_id }}\", \"trigger_type\": \"{{ $('Disparo on-demand (webhook)').isExecuted ? 'on_demand' : ($('Ejecutar manual').isExecuted ? 'manual' : 'cron') }}\", \"estado\": \"en_curso\", \"params\": { \"workflow\": \"linkedin\", \"execution_id\": \"{{ $execution.id }}\" } }",
        "options": {
          "timeout": 15000
        }
      },
      "id": "abrir-run-en-el-registro",
      "name": "Abrir run en el registro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 320],
      "onError": "continueRegularOutput",
      "credentials": {
        "supabaseApi": {
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.dashboard_url + '/api/engine/run-plan?ambito=motor&instancia=' + $('Config').first().json.instance_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "leer-plan-fachada",
      "name": "Leer plan (fachada)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 320],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Run Plan Header"
        }
      },
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "La config del cockpit (ADR-028). FAIL-CLOSED a proposito: sin onError, cualquier respuesta !=200 tras 3 intentos aborta el run.\n\n`ambito=motor` NO dice que este sea el pipeline de reels: son DOS EJES (ADR-068). El pipeline lo DERIVA la fachada de la instancia y no se pide nunca; `ambito` es solo el filtro (motor = con filtros, completo = sin ellos). Este workflow pide el filtrado, y lo que recibe es el plan de LinkedIn porque su instancia lo es."
    },
    {
      "parameters": {
        "jsCode": "// Cierre del ESQUELETO. Todavía no hay etapas de contenido: colectar y generar esperan el banco\n// de referentes y los few-shot de Fernando (ADR-055 §Consecuencias), que no son problemas de código.\n//\n// Lo que este nodo SÍ hace no es relleno: verifica ADR-068 desde adentro de n8n, que es el único\n// lugar donde importa, y deja la medición escrita en `runs.metricas`.\n\nconst plan = $('Leer plan (fachada)').first().json || {};\n\n// 🔴 La afirmación que ADR-068 existe para habilitar, y por eso este workflow es su primer\n// consumidor. La fachada deriva el pipeline de la instancia, así que un plan que dice otra cosa\n// significa que este workflow está apuntado a una instancia ajena. **Ese fallo no produce un error\n// río arriba: produce un documento bien formado**, con voces y referentes de verdad adentro. Es el\n// único punto donde se puede cazar, y se corta con el run YA ABIERTO para que quede la fila.\nif (plan.pipeline !== 'linkedin') {\n  throw new Error(\n    `run-plan devolvió pipeline='${plan.pipeline}' (esperaba 'linkedin'): esta corrida está apuntada a una instancia que no es de LinkedIn. No se escribió nada.`,\n  );\n}\n\nconst voces = Array.isArray(plan.voces) ? plan.voces : [];\nconst referentes = Array.isArray(plan.referentes) ? plan.referentes : [];\n\n// Las dos cifras que deciden si el motor tendría con qué trabajar el día que exista. Hoy son 0 y 0\n// en las tres marcas, y esa es la respuesta correcta: el banco hay que construirlo, no capturarlo.\nreturn [\n  {\n    json: {\n      metricas: {\n        etapa: 'esqueleto',\n        pipeline: plan.pipeline,\n        voces_con_perfil: voces.length,\n        referentes_activos: referentes.length,\n        nota: 'Esqueleto de infraestructura: sin etapas de contenido. Ver Workflows/workflow-linkedin/README.md',\n      },\n    },\n  },\n];\n"
      },
      "id": "resumen-del-run",
      "name": "Resumen del run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 320],
      "notes": "Afirma que el plan recibido es el de LinkedIn (ADR-068) y reporta qué trajo. Es el smoke test del cableado, no una etapa del pipeline.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').first().json.supabase_url + '/rest/v1/runs?id=eq.' + ($('Abrir run en el registro').first().json.id || '00000000-0000-0000-0000-000000000000') }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { fin: $now.toISO(), estado: 'ok', metricas: $json.metricas } }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "cerrar-run-en-el-registro",
      "name": "Cerrar run en el registro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 320],
      "onError": "continueRegularOutput",
      "credentials": {
        "supabaseApi": {
          "name": "Supabase account"
        }
      },
      "executeOnce": true
    }
