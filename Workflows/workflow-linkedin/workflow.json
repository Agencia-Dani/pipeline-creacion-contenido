        "url": "={{ $('Config').first().json.supabase_url + '/rest/v1/runs?params-%3E%3Eworkflow=eq.linkedin&instance_id=eq.' + $('Config').first().json.instance_id + '&estado=eq.en_curso&inicio=gte.' + encodeURIComponent($now.minus({ minutes: $('Config').first().json.ventana_corrida_min || 120 }).toISO()) + '&select=id,inicio,trigger_type&limit=1' }}",
        "authentication": "predefinedCredentialType",
